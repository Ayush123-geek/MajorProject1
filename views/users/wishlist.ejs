<% layout("/layouts/boilerplate") %>
<div class="mt-3 mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-bold mb-1"><i class="fa-solid fa-heart me-2 text-danger"></i>Your Wishlist</h3>
            <p class="text-muted small mb-0">Your saved dream destinations & favorite stays</p>
        </div>
        <span class="badge bg-danger rounded-pill fs-6 px-3 py-2"><%= wishlistListings.length %> Saved</span>
    </div>

    <% if (wishlistListings.length === 0) { %>
        <div class="text-center py-5">
            <div class="bg-body-secondary rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                <i class="fa-regular fa-heart fa-2x text-muted"></i>
            </div>
            <h4 class="fw-bold">Your Wishlist is Empty</h4>
            <p class="text-muted">Explore listings and click the heart icon to save your favorite destinations!</p>
            <a href="/listings" class="btn btn-brand rounded-pill px-4 py-2 mt-2"><i class="fa-solid fa-compass me-2"></i>Explore Stays</a>
        </div>
    <% } else { %>
        <div class="listings-grid">
            <% for(let listing of wishlistListings) { %>
                <div class="listing-card">
                    <div class="card-img-container">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                        </a>
                        <% if (listing.category) { %>
                            <span class="category-badge"><%= listing.category %></span>
                        <% } %>
                        <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="wishlist-form">
                            <button type="submit" class="wishlist-btn" title="Remove from Wishlist">
                                <i class="fa-solid fa-heart"></i>
                            </button>
                        </form>
                    </div>
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card-body">
                            <div>
                                <h5 class="card-title text-truncate"><%= listing.title %></h5>
                                <p class="card-location"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
                            </div>
                            <div class="card-price-row">
                                <div>
                                    <span class="card-price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                    <span class="text-muted small"> / night</span>
                                </div>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    <% } %>
</div>
