<% layout("/layouts/boilerplate") %>

<div class="row mt-3 justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card border rounded-4 p-4 p-md-5 shadow-sm bg-body">
            <div class="d-flex align-items-center gap-3 mb-4">
                <div class="rounded-circle bg-danger bg-opacity-10 text-danger p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fa-solid fa-pen-to-square fs-4"></i>
                </div>
                <div>
                    <h3 class="fw-bold mb-0">Edit your Listing</h3>
                    <p class="text-muted small mb-0">Update property details, pricing, and photos</p>
                </div>
            </div>

            <form method="post" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div class="mb-3">
                    <label for="title" class="form-label small fw-semibold text-muted">PROPERTY TITLE</label>
                    <input type="text" name="listing[title]" id="title" value="<%= listing.title %>" class="form-control rounded-3" required>
                    <div class="invalid-feedback">Title cannot be empty.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label small fw-semibold text-muted">DESCRIPTION</label>
                    <textarea name="listing[description]" id="description" rows="4" class="form-control rounded-3" required><%= listing.description.trim() %></textarea>
                    <div class="invalid-feedback">Please write a short description.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label small fw-semibold text-muted d-block">CURRENT PHOTO PREVIEW</label>
                    <div class="rounded-3 overflow-hidden border d-inline-block shadow-sm" style="width: 140px; height: 100px;">
                        <img src="<%= originalImageUrl %>" class="w-100 h-100 object-fit-cover" alt="Listing photo">
                    </div>
                </div>

                <div class="mb-3">
                    <label for="image" class="form-label small fw-semibold text-muted">REPLACE PHOTO (OPTIONAL)</label>
                    <input type="file" name="listing[image]" id="image" class="form-control rounded-3">
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label for="price" class="form-label small fw-semibold text-muted">NIGHTLY PRICE (&#8377;)</label>
                        <div class="input-group">
                            <span class="input-group-text">&#8377;</span>
                            <input type="number" name="listing[price]" id="price" value="<%= listing.price %>" class="form-control" required min="100">
                        </div>
                        <div class="invalid-feedback">Please enter a valid price.</div>
                    </div>
                    <div class="col-md-4">
                        <label for="category" class="form-label small fw-semibold text-muted">CATEGORY</label>
                        <select name="listing[category]" id="category" class="form-select rounded-3" required>
                            <% const categories = ["Trending", "Rooms", "Iconic Cities", "Mountains", "Castles", "Amazing Pools", "Camping", "Farms", "Arctic", "Domes", "Boats"]; %>
                            <% for (let cat of categories) { %>
                                <option value="<%= cat %>" <%= listing.category === cat ? "selected" : "" %>><%= cat %></option>
                            <% } %>
                        </select>
                    </div>
                    <div class="col-md-4">
                        <label for="country" class="form-label small fw-semibold text-muted">COUNTRY</label>
                        <input type="text" name="listing[country]" id="country" value="<%= listing.country %>" class="form-control rounded-3" required>
                        <div class="invalid-feedback">Country name is required.</div>
                    </div>
                </div>

                <div class="mb-4">
                    <label for="location" class="form-label small fw-semibold text-muted">LOCATION / CITY</label>
                    <input type="text" name="listing[location]" id="location" value="<%= listing.location %>" class="form-control rounded-3" required>
                    <div class="invalid-feedback">Location is required.</div>
                </div>

                <div class="d-flex gap-3">
                    <button class="btn btn-brand rounded-pill px-4 py-2 fw-bold flex-grow-1 shadow-sm">
                        <i class="fa-solid fa-check me-1"></i>Save Changes
                    </button>
                    <a href="/listings/<%= listing._id %>" class="btn btn-outline-secondary rounded-pill px-4 py-2">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
