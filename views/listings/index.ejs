<% layout("/layouts/boilerplate") %>

    <style>
        #filters {
            display: flex;
            flex-wrap: wrap;
            align-items: center;
        }
        .filter {
            text-align: center;
            margin-right: 1.65rem;
            margin-top: 1rem;
            opacity: 0.7;
            text-decoration: none;
            color: inherit;
            padding-bottom: 0.25rem;
            transition: all 0.2s ease;
        }
        .filter:hover, .filter.active-filter {
            opacity: 1;
            color: #fe424d;
            border-bottom: 2px solid #fe424d;
        }
        .filter p {
            font-size: 0.8rem;
            margin-bottom: 0;
        }
        .tax-info {
            display: none;
        }
        .tax-toggle {
            border: 1px solid var(--border-light);
            border-radius: 1rem;
            height: 3.25rem;
            padding: 0.75rem 1rem;
            margin-left: auto;
            margin-top: 0.75rem;
            display: flex;
            align-items: center;
            background-color: var(--bg-card);
            color: var(--text-main);
        }
    </style>

    <div id="filters">
        <a href="/listings" class="filter <%= !selectedCategory ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-border-all"></i></div>
            <p>All</p>
        </a>

        <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-fire"></i></div>
            <p>Trending</p>
        </a>

        <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-bed"></i></div>
            <p>Rooms</p>
        </a>

        <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain-city"></i></div>
            <p>Iconic cities</p>
        </a>

        <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-mountain-sun"></i></div>
            <p>Mountains</p>
        </a>

        <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
            <div><i class="fa-brands fa-fort-awesome"></i></div>
            <p>Castles</p>
        </a>

        <a href="/listings?category=Amazing Pools" class="filter <%= selectedCategory === 'Amazing Pools' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-person-swimming"></i></div>
            <p>Amazing pools</p>
        </a>

        <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-campground"></i></div>
            <p>Camping</p>
        </a>

        <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-cow"></i></div>
            <p>Farms</p>
        </a>

        <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-snowflake"></i></div>
            <p>Arctic</p>
        </a>

        <a href="/listings?category=Domes" class="filter <%= selectedCategory === 'Domes' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-igloo"></i></div>
            <p>Domes</p>
        </a>

        <a href="/listings?category=Boats" class="filter <%= selectedCategory === 'Boats' ? 'active-filter' : '' %>">
            <div><i class="fa-solid fa-sailboat"></i></div>
            <p>Boats</p>
        </a>

        <div class="tax-toggle">
            <div class="form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <% if (allListings.length === 0) { %>
        <div class="text-center my-5 py-5">
            <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
            <h4>No listings found</h4>
            <p class="text-muted">Try modifying your search query or selecting a different category filter.</p>
            <a href="/listings" class="btn btn-outline-danger mt-2">Clear Filters & Search</a>
        </div>
    <% } else { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
            <% for(let listing of allListings){ %>
                <a href="/listings/<%= listing._id %>" class="listing-link">
                    <div class="card col listing-card">
                        <div class="card-img-container">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img">
                            <% if (listing.category) { %>
                                <span class="category-badge"><%= listing.category %></span>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-truncate"><%= listing.title %></h5>
                            <p class="card-text mb-0">
                                <span class="card-price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="text-muted fw-normal"> / night</span>
                                <i class="tax-info text-muted ms-2">+18% GST</i>
                            </p>
                        </div>
                    </div>
                </a>
            <% } %>
        </div>
    <% } %>

<script>
    let taxSwitch=document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("click",()=>{
        let taxInfo=document.getElementsByClassName("tax-info");
        for(info of taxInfo){
            if(info.style.display!="inline"){
                info.style.display="inline";
            }
            else{
                info.style.display="none";
            }
        }
    })
</script>