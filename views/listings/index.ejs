<% layout("/layouts/boilerplate") %>

    <style>
        .filter-section {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1.5rem;
            margin-top: 1rem;
            margin-bottom: 1.25rem;
        }

        .filters-container {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            overflow-x: auto;
            scrollbar-width: none;
            -ms-overflow-style: none;
            padding-bottom: 0.25rem;
            flex: 1;
        }

        .filters-container::-webkit-scrollbar {
            display: none;
        }

        .filter {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-decoration: none;
            color: var(--text-muted);
            font-size: 0.8rem;
            font-weight: 500;
            white-space: nowrap;
            padding: 0.4rem 0.6rem;
            border-bottom: 2px solid transparent;
            transition: all 0.2s ease;
            cursor: pointer;
        }

        .filter i {
            font-size: 1.25rem;
            margin-bottom: 0.35rem;
            transition: transform 0.2s ease;
        }

        .filter:hover, .filter.active-filter {
            color: var(--brand-primary);
            border-bottom-color: var(--brand-primary);
            opacity: 1;
        }

        .filter:hover i {
            transform: translateY(-2px);
        }

        .filter-btn-trigger {
            border: 1px solid var(--border-light);
            border-radius: 2rem;
            padding: 0.5rem 1.1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            background-color: var(--bg-card);
            color: var(--text-main);
            font-size: 0.85rem;
            font-weight: 600;
            white-space: nowrap;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
            flex-shrink: 0;
            cursor: pointer;
        }

        .filter-btn-trigger:hover {
            border-color: var(--brand-primary);
            box-shadow: var(--shadow-hover);
            color: var(--brand-primary);
        }

        .tax-toggle {
            border: 1px solid var(--border-light);
            border-radius: 2rem;
            padding: 0.5rem 1.1rem;
            display: flex;
            align-items: center;
            background-color: var(--bg-card);
            color: var(--text-main);
            white-space: nowrap;
            box-shadow: var(--shadow-sm);
            transition: all 0.2s ease;
            flex-shrink: 0;
            cursor: pointer;
        }

        .tax-toggle:hover {
            border-color: var(--brand-primary);
            box-shadow: var(--shadow-hover);
        }

        .tax-toggle .form-check-input {
            cursor: pointer;
        }

        .tax-toggle .form-check-input:checked {
            background-color: var(--brand-primary);
            border-color: var(--brand-primary);
        }

        .tax-toggle label {
            cursor: pointer;
            font-size: 0.85rem;
            font-weight: 600;
            user-select: none;
        }

        .amenity-chip {
            border: 1px solid var(--border-light);
            border-radius: 2rem;
            padding: 0.4rem 0.9rem;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.2s ease;
            user-select: none;
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
        }

        .btn-check:checked + .amenity-chip {
            background-color: rgba(254, 66, 77, 0.1);
            color: var(--brand-primary);
            border-color: var(--brand-primary);
            font-weight: 600;
        }

        .mini-amenity-badge {
            font-size: 0.7rem;
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(4px);
            color: var(--text-main);
            border: 1px solid var(--border-light);
            padding: 0.15rem 0.5rem;
            border-radius: 1rem;
            font-weight: 600;
        }

        [data-bs-theme="dark"] .mini-amenity-badge {
            background: rgba(30, 41, 59, 0.85);
            color: var(--text-main);
        }
    </style>

    <div class="filter-section">
        <div class="filters-container">
            <a href="/listings" class="filter <%= !selectedCategory ? 'active-filter' : '' %>">
                <i class="fa-solid fa-border-all"></i>
                <span>All Stays</span>
            </a>
            <a href="/listings?category=Trending" class="filter <%= selectedCategory === 'Trending' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-fire"></i>
                <span>Trending</span>
            </a>
            <a href="/listings?category=Rooms" class="filter <%= selectedCategory === 'Rooms' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-bed"></i>
                <span>Rooms</span>
            </a>
            <a href="/listings?category=Iconic Cities" class="filter <%= selectedCategory === 'Iconic Cities' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-mountain-city"></i>
                <span>Iconic cities</span>
            </a>
            <a href="/listings?category=Mountains" class="filter <%= selectedCategory === 'Mountains' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-mountain-sun"></i>
                <span>Mountains</span>
            </a>
            <a href="/listings?category=Castles" class="filter <%= selectedCategory === 'Castles' ? 'active-filter' : '' %>">
                <i class="fa-brands fa-fort-awesome"></i>
                <span>Castles</span>
            </a>
            <a href="/listings?category=Amazing Pools" class="filter <%= selectedCategory === 'Amazing Pools' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-person-swimming"></i>
                <span>Amazing pools</span>
            </a>
            <a href="/listings?category=Camping" class="filter <%= selectedCategory === 'Camping' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-campground"></i>
                <span>Camping</span>
            </a>
            <a href="/listings?category=Farms" class="filter <%= selectedCategory === 'Farms' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-cow"></i>
                <span>Farms</span>
            </a>
            <a href="/listings?category=Arctic" class="filter <%= selectedCategory === 'Arctic' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-snowflake"></i>
                <span>Arctic</span>
            </a>
            <a href="/listings?category=Domes" class="filter <%= selectedCategory === 'Domes' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-igloo"></i>
                <span>Domes</span>
            </a>
            <a href="/listings?category=Boats" class="filter <%= selectedCategory === 'Boats' ? 'active-filter' : '' %>">
                <i class="fa-solid fa-sailboat"></i>
                <span>Boats</span>
            </a>
        </div>

        <!-- Filter Modal Trigger Button -->
        <button class="filter-btn-trigger" data-bs-toggle="modal" data-bs-target="#filterModal">
            <i class="fa-solid fa-sliders"></i>
            <span>Filters</span>
            <% const activeCount = (minPrice ? 1 : 0) + (maxPrice ? 1 : 0) + selectedAmenities.length; %>
            <% if (activeCount > 0) { %>
                <span class="badge bg-danger rounded-circle p-1"><%= activeCount %></span>
            <% } %>
        </button>

        <div class="tax-toggle">
            <div class="form-check form-switch m-0 d-flex align-items-center gap-2">
                <input class="form-check-input mt-0" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
            </div>
        </div>
    </div>

    <!-- Active Filter Tags Indicator Bar -->
    <% if (minPrice || maxPrice || selectedAmenities.length > 0 || searchQuery || selectedCategory) { %>
        <div class="d-flex align-items-center flex-wrap gap-2 mb-3">
            <small class="text-muted fw-semibold me-1">Active Filters:</small>
            <% if (selectedCategory) { %>
                <span class="badge bg-secondary-subtle text-secondary border px-2 py-1">Category: <%= selectedCategory %></span>
            <% } %>
            <% if (minPrice || maxPrice) { %>
                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">
                    Price: &#8377;<%= minPrice || 0 %> - &#8377;<%= maxPrice || 'Max' %>
                </span>
            <% } %>
            <% for (let am of selectedAmenities) { %>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1"><%= am %></span>
            <% } %>
            <a href="/listings" class="small text-danger fw-semibold ms-2 text-decoration-none"><i class="fa-solid fa-xmark me-1"></i>Reset All</a>
        </div>
    <% } %>

    <% if (allListings.length === 0) { %>
        <div class="text-center my-5 py-5">
            <i class="fa-solid fa-magnifying-glass fa-3x text-muted mb-3"></i>
            <h4>No listings match your filter criteria</h4>
            <p class="text-muted">Try expanding your price range or selecting fewer amenity tags.</p>
            <a href="/listings" class="btn btn-brand mt-2">Clear Filters & Search</a>
        </div>
    <% } else { %>
        <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1">
            <% for(let listing of allListings){ %>
                <div class="card col listing-card">
                    <div class="card-img-container">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <img src="<%= listing.image.url %>" class="card-img-top" alt="listing_img">
                        </a>
                        <% if (listing.category) { %>
                            <span class="category-badge"><%= listing.category %></span>
                        <% } %>
                        <form method="POST" action="/listings/<%= listing._id %>/wishlist" class="wishlist-form">
                            <button type="submit" class="wishlist-btn" title="Save to Wishlist">
                                <% if(currUserWishlist.includes(listing._id.toString())) { %>
                                    <i class="fa-solid fa-heart"></i>
                                <% } else { %>
                                    <i class="fa-regular fa-heart"></i>
                                <% } %>
                            </button>
                        </form>
                    </div>
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="card-body">
                            <h5 class="card-title text-truncate"><%= listing.title %></h5>
                            <p class="card-text mb-1">
                                <span class="base-price card-price">&#8377;<%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="tax-price card-price d-none">&#8377;<%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : 0 %></span>
                                <span class="text-muted fw-normal"> / night</span>
                                <i class="tax-info text-muted ms-2 style-gst">+18% GST</i>
                            </p>
                            <% if (listing.amenities && listing.amenities.length > 0) { %>
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    <% for (let am of listing.amenities.slice(0, 3)) { %>
                                        <span class="mini-amenity-badge"><%= am %></span>
                                    <% } %>
                                    <% if (listing.amenities.length > 3) { %>
                                        <span class="mini-amenity-badge">+<%= listing.amenities.length - 3 %></span>
                                    <% } %>
                                </div>
                            <% } %>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    <% } %>

    <!-- Multi-Criteria Filter Modal -->
    <div class="modal fade" id="filterModal" tabindex="-1" aria-labelledby="filterModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content rounded-4 border-0 shadow">
                <form action="/listings" method="GET">
                    <!-- Preserve existing search/category params -->
                    <% if (searchQuery) { %><input type="hidden" name="q" value="<%= searchQuery %>"><% } %>
                    <% if (selectedCategory) { %><input type="hidden" name="category" value="<%= selectedCategory %>"><% } %>

                    <div class="modal-header bg-body-tertiary border-bottom px-4 py-3">
                        <h5 class="modal-title fw-bold" id="filterModalLabel"><i class="fa-solid fa-sliders text-danger me-2"></i>Filter Stays</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body p-4">
                        <!-- Price Range Filter -->
                        <div class="mb-4">
                            <h6 class="fw-bold mb-3">Nightly Price Range (&#8377;)</h6>
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small text-muted">Min Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">&#8377;</span>
                                        <input type="number" name="minPrice" class="form-control" placeholder="0" value="<%= minPrice %>" min="0">
                                    </div>
                                </div>
                                <div class="col-6">
                                    <label class="form-label small text-muted">Max Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">&#8377;</span>
                                        <input type="number" name="maxPrice" class="form-control" placeholder="20000" value="<%= maxPrice %>" min="0">
                                    </div>
                                </div>
                            </div>
                        </div>

                        <hr>

                        <!-- Amenities Filter -->
                        <div>
                            <h6 class="fw-bold mb-3">Amenities & Features</h6>
                            <% const availableAmenities = [
                                { name: "WiFi", icon: "fa-wifi" },
                                { name: "Pool", icon: "fa-person-swimming" },
                                { name: "AC", icon: "fa-snowflake" },
                                { name: "Free Parking", icon: "fa-square-parking" },
                                { name: "Kitchen", icon: "fa-kitchen-set" },
                                { name: "TV", icon: "fa-tv" },
                                { name: "Pet Friendly", icon: "fa-dog" }
                            ]; %>

                            <div class="d-flex flex-wrap gap-2">
                                <% for (let item of availableAmenities) { %>
                                    <% const isChecked = selectedAmenities.includes(item.name); %>
                                    <input type="checkbox" class="btn-check" id="am-<%= item.name %>" name="amenities" value="<%= item.name %>" <%= isChecked ? 'checked' : '' %>>
                                    <label class="amenity-chip" for="am-<%= item.name %>">
                                        <i class="fa-solid <%= item.icon %>"></i> <%= item.name %>
                                    </label>
                                <% } %>
                            </div>
                        </div>
                    </div>

                    <div class="modal-footer bg-body-tertiary border-top px-4 py-3 d-flex justify-content-between">
                        <a href="/listings" class="btn btn-outline-secondary btn-sm">Clear All</a>
                        <button type="submit" class="btn btn-brand px-4">Apply Filters</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    if (taxSwitch) {
        taxSwitch.addEventListener("change", () => {
            const basePrices = document.querySelectorAll(".base-price");
            const taxPrices = document.querySelectorAll(".tax-price");
            const taxInfos = document.querySelectorAll(".tax-info");

            if (taxSwitch.checked) {
                basePrices.forEach(el => el.classList.add("d-none"));
                taxPrices.forEach(el => el.classList.remove("d-none"));
                taxInfos.forEach(el => el.style.display = "inline");
            } else {
                basePrices.forEach(el => el.classList.remove("d-none"));
                taxPrices.forEach(el => el.classList.add("d-none"));
                taxInfos.forEach(el => el.style.display = "none");
            }
        });
    }
</script>