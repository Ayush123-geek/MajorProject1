<% layout("/layouts/boilerplate") %>

<!-- Flatpickr Datepicker & Razorpay SDK -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
<script src="https://checkout.razorpay.com/v1/checkout.js"></script>

<%
    // Calculate Average Rating
    let avgRating = 0;
    if (listing.reviews && listing.reviews.length > 0) {
        const totalRating = listing.reviews.reduce((sum, r) => sum + (r.rating || 5), 0);
        avgRating = (totalRating / listing.reviews.length).toFixed(1);
    }
%>

<div class="row mt-2">
    <!-- Header: Title & Wishlist -->
    <div class="col-lg-10 offset-lg-1">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <div>
                <h2 class="fw-bold mb-1"><%= listing.title %></h2>
                <div class="d-flex align-items-center gap-3 text-muted small flex-wrap">
                    <% if (listing.reviews && listing.reviews.length > 0) { %>
                        <span class="fw-bold text-dark"><i class="fa-solid fa-star text-warning me-1"></i><%= avgRating %> (<%= listing.reviews.length %> <%= listing.reviews.length === 1 ? 'review' : 'reviews' %>)</span>
                        <span>&bull;</span>
                    <% } %>
                    <span><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></span>
                </div>
            </div>
            <% if(currUser) { %>
                <form method="POST" action="/listings/<%= listing._id %>/wishlist">
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3 py-1.5 shadow-sm">
                        <% if(currUserWishlist.includes(listing._id.toString())) { %>
                            <i class="fa-solid fa-heart me-1"></i> Saved in Wishlist
                        <% } else { %>
                            <i class="fa-regular fa-heart me-1"></i> Save to Wishlist
                        <% } %>
                    </button>
                </form>
            <% } %>
        </div>
    </div>

    <!-- Main Content & Booking Widget -->
    <div class="col-lg-10 offset-lg-1">
        <div class="row g-4">
            <!-- Left Column: Image, Host, Description, Amenities -->
            <div class="col-lg-7">
                <!-- Stay Image Container -->
                <div class="position-relative rounded-4 overflow-hidden shadow-sm mb-4" style="height: 24rem; background-color: var(--border-light);">
                    <img src="<%= listing.image.url %>" class="w-100 h-100 object-fit-cover" alt="<%= listing.title %>">
                    <% if (listing.category) { %>
                        <span class="category-badge fs-6 px-3 py-1.5"><%= listing.category %></span>
                    <% } %>
                </div>

                <!-- Host Profile Card -->
                <div class="card border rounded-4 p-3 mb-4 shadow-sm">
                    <div class="d-flex align-items-center gap-3">
                        <div class="rounded-circle bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center justify-content-center" style="width: 52px; height: 52px; font-size: 1.35rem;">
                            <%= (listing.owner ? listing.owner.username : 'H')[0].toUpperCase() %>
                        </div>
                        <div>
                            <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner ? listing.owner.username : 'Wanderlust Host' %></h6>
                            <small class="text-muted"><i class="fa-solid fa-circle-check text-success me-1"></i>Verified Host &bull; Fast Responder</small>
                        </div>
                    </div>
                </div>

                <!-- Description -->
                <div class="mb-4">
                    <h5 class="fw-bold mb-2">About this space</h5>
                    <p class="text-secondary lh-lg mb-0"><%= listing.description %></p>
                </div>

                <hr class="my-4">

                <!-- Amenities Section -->
                <% if (listing.amenities && listing.amenities.length > 0) { %>
                    <div class="mb-4">
                        <h5 class="fw-bold mb-3">What this place offers</h5>
                        <div class="row row-cols-2 g-3">
                            <% for (let am of listing.amenities) { %>
                                <div class="col d-flex align-items-center gap-2 text-secondary">
                                    <% if (am === 'WiFi') { %><i class="fa-solid fa-wifi text-danger fs-5"></i>
                                    <% } else if (am === 'Pool') { %><i class="fa-solid fa-person-swimming text-primary fs-5"></i>
                                    <% } else if (am === 'AC') { %><i class="fa-solid fa-snowflake text-info fs-5"></i>
                                    <% } else if (am === 'Free Parking') { %><i class="fa-solid fa-square-parking text-success fs-5"></i>
                                    <% } else if (am === 'Kitchen') { %><i class="fa-solid fa-kitchen-set text-warning fs-5"></i>
                                    <% } else if (am === 'TV') { %><i class="fa-solid fa-tv text-secondary fs-5"></i>
                                    <% } else if (am === 'Pet Friendly') { %><i class="fa-solid fa-dog text-warning fs-5"></i>
                                    <% } else { %><i class="fa-solid fa-circle-check text-success fs-5"></i><% } %>
                                    <span class="fw-semibold small"><%= am %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                    <hr class="my-4">
                <% } %>

                <!-- Host Controls (if Owner) -->
                <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
                    <div class="d-flex gap-2 mb-4">
                        <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn px-4"><i class="fa-solid fa-pen-to-square me-1"></i>Edit Listing</a>
                        <form method="post" action="/listings/<%= listing._id %>?_method=Delete">
                            <button class="btn btn-outline-dark rounded-pill px-4"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                        </form>
                    </div>
                <% } %>
            </div>

            <!-- Right Column: Interactive Booking Widget -->
            <div class="col-lg-5">
                <div class="card shadow-sm border rounded-4 sticky-top" style="top: 6rem; z-index: 10;">
                    <div class="card-body p-4">
                        <div class="d-flex align-items-baseline justify-content-between mb-3">
                            <div>
                                <span class="fs-3 fw-bold text-danger">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                                <span class="text-muted fs-6">/ night</span>
                            </div>
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1"><i class="fa-solid fa-shield-halved me-1"></i>Razorpay Secure</span>
                        </div>
                        <hr class="mb-4">

                        <% if (currUser) { %>
                            <form id="bookingForm">
                                <div class="mb-3">
                                    <label for="checkIn" class="form-label fw-semibold small text-muted">CHECK-IN DATE</label>
                                    <input type="text" name="checkIn" id="checkIn" class="form-control rounded-3" placeholder="Select check-in" required>
                                </div>
                                <div class="mb-3">
                                    <label for="checkOut" class="form-label fw-semibold small text-muted">CHECK-OUT DATE</label>
                                    <input type="text" name="checkOut" id="checkOut" class="form-control rounded-3" placeholder="Select check-out" required>
                                </div>

                                <!-- Dynamic Night & Cost Calculation Box -->
                                <div id="costSummary" class="p-3 my-3 bg-body-tertiary rounded-3 border d-none">
                                    <div class="d-flex justify-content-between small text-muted mb-1">
                                        <span>&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %> &times; <span id="numNights">1</span> night(s)</span>
                                        <span class="fw-semibold text-body">&#8377; <span id="baseTotal">0</span></span>
                                    </div>
                                    <div class="d-flex justify-content-between small text-muted mb-2">
                                        <span>GST (18%)</span>
                                        <span class="fw-semibold text-body">&#8377; <span id="gstTotal">0</span></span>
                                    </div>
                                    <hr class="my-2">
                                    <div class="d-flex justify-content-between fw-bold">
                                        <span>Total Payable:</span>
                                        <span class="text-danger">&#8377; <span id="grandTotal">0</span></span>
                                    </div>
                                </div>

                                <button type="submit" id="payBtn" class="btn btn-brand w-100 py-2.5 fs-6 fw-bold shadow-sm">
                                    <i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay
                                </button>
                            </form>
                        <% } else { %>
                            <div class="text-center py-3">
                                <p class="text-muted small mb-3">Please log in to check availability and reserve this stay.</p>
                                <a href="/login" class="btn btn-brand w-100 py-2 fw-bold">Log in to Book</a>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Redesigned Reviews Section -->
    <div class="col-lg-10 offset-lg-1 mb-4 mt-4">
        <hr class="mb-4">
        
        <!-- Rating Header Score Box -->
        <div class="review-score-box d-flex align-items-center justify-content-between flex-wrap gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="display-5 fw-bold text-danger"><i class="fa-solid fa-star text-warning me-1"></i><%= avgRating > 0 ? avgRating : 'New' %></div>
                <div>
                    <h5 class="mb-0 fw-bold">Guest Favorite</h5>
                    <p class="text-muted small mb-0"><%= listing.reviews.length %> verified <%= listing.reviews.length === 1 ? 'review' : 'reviews' %></p>
                </div>
            </div>
            <% if(currUser) { %>
                <a href="#reviewFormBox" class="btn btn-outline-danger btn-sm rounded-pill px-3 py-1.5 fw-semibold">
                    <i class="fa-solid fa-pen-nib me-1"></i>Write a Review
                </a>
            <% } %>
        </div>

        <!-- Review Composer Form -->
        <% if(currUser) { %>
            <div class="review-composer-card" id="reviewFormBox">
                <h5 class="fw-bold mb-3"><i class="fa-solid fa-pen-nib text-danger me-2"></i>Leave a Review</h5>
                <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                    <div class="mb-3">
                        <label for="rating" class="form-label small fw-semibold text-muted">OVERALL RATING</label>
                        <fieldset class="starability-slot">
                            <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="5" checked aria-label="No rating." />
                            <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                            <label for="first-rate1" title="Terrible">1 star</label>
                            <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                            <label for="first-rate2" title="Not good">2 stars</label>
                            <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                            <label for="first-rate3" title="Average">3 stars</label>
                            <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                            <label for="first-rate4" title="Very good">4 stars</label>
                            <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                            <label for="first-rate5" title="Amazing">5 stars</label>
                        </fieldset>
                    </div>
                    <div class="mb-3">
                        <label for="comment" class="form-label small fw-semibold text-muted">YOUR FEEDBACK</label>
                        <textarea name="review[comment]" id="comment" cols="30" rows="3" class="form-control rounded-3" placeholder="How was your stay? Mention cleanliness, amenities, location..." required></textarea>
                        <div class="invalid-feedback">Please share some comments before submitting!</div>
                    </div>
                    <button class="btn btn-brand rounded-pill px-4">Post Review</button>
                </form>
            </div>
        <% } %>

        <!-- Review Cards Grid -->
        <% if(listing.reviews.length > 0) { %>
            <div class="row row-cols-1 row-cols-md-2 g-3">
                <% for(review of listing.reviews) { %>
                    <div class="col">
                        <div class="review-card-item">
                            <div>
                                <div class="d-flex align-items-center gap-3 mb-2">
                                    <div class="review-avatar">
                                        <%= (review.author ? review.author.username : 'U')[0].toUpperCase() %>
                                    </div>
                                    <div>
                                        <h6 class="mb-0 fw-bold"><%= review.author ? review.author.username : 'Wanderlust Guest' %></h6>
                                        <p class="starability-result card-text mb-0" data-rating="<%= review.rating %>"></p>
                                    </div>
                                </div>
                                <p class="card-text text-secondary mt-2 small lh-base"><%= review.comment %></p>
                            </div>
                            <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                                <form class="mt-2 text-end" method="post" action="/listings/<%=listing._id %>/reviews/<%=review._id%>?_method=Delete">
                                    <button class="btn btn-sm btn-link text-danger p-0 text-decoration-none small">
                                        <i class="fa-solid fa-trash-can me-1"></i>Delete
                                    </button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <div class="text-center py-4 text-muted">
                <i class="fa-regular fa-comment-dots fa-2x mb-2 opacity-50"></i>
                <p class="mb-0 small">No reviews yet for this stay. Be the first to leave a review!</p>
            </div>
        <% } %>
    </div>

    <!-- Map Section -->
    <div class="col-lg-10 offset-lg-1 mb-4 mt-2">
        <hr class="mb-4">
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Where you'll be</h4>
        <div id="map"></div>
    </div>
</div>

<script>
    const nightPrice = <%= listing.price || 0 %>;
    const listingId = "<%= listing._id %>";
    const currUserEmail = "<%= currUser ? currUser.email : '' %>";
    const currUserName = "<%= currUser ? currUser.username : '' %>";

    const today = new Date().toISOString().split('T')[0];
    
    const checkInPicker = flatpickr("#checkIn", {
        minDate: today,
        dateFormat: "Y-m-d",
        onChange: function(selectedDates, dateStr) {
            checkOutPicker.set('minDate', dateStr);
            calculateCost();
        }
    });

    const checkOutPicker = flatpickr("#checkOut", {
        minDate: today,
        dateFormat: "Y-m-d",
        onChange: function() {
            calculateCost();
        }
    });

    function calculateCost() {
        const inDate = checkInPicker.selectedDates[0];
        const outDate = checkOutPicker.selectedDates[0];

        if (inDate && outDate && outDate > inDate) {
            const diffTime = Math.abs(outDate - inDate);
            const nights = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            const base = nightPrice * nights;
            const gst = Math.round(base * 0.18);
            const total = base + gst;

            document.getElementById("numNights").innerText = nights;
            document.getElementById("baseTotal").innerText = base.toLocaleString("en-IN");
            document.getElementById("gstTotal").innerText = gst.toLocaleString("en-IN");
            document.getElementById("grandTotal").innerText = total.toLocaleString("en-IN");

            document.getElementById("costSummary").classList.remove("d-none");
        } else {
            document.getElementById("costSummary").classList.add("d-none");
        }
    }

    // Razorpay Official Checkout Handler
    const bookingForm = document.getElementById("bookingForm");
    if (bookingForm) {
        bookingForm.addEventListener("submit", async (e) => {
            e.preventDefault();
            const checkIn = document.getElementById("checkIn").value;
            const checkOut = document.getElementById("checkOut").value;

            if (!checkIn || !checkOut) {
                alert("Please select valid check-in and check-out dates.");
                return;
            }

            const payBtn = document.getElementById("payBtn");
            payBtn.disabled = true;
            payBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Connecting to Razorpay...`;

            try {
                // Step 1: Create Order
                const res = await fetch(`/listings/${listingId}/create-payment-order`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ checkIn, checkOut }),
                });

                const data = await res.json();

                if (!data.success) {
                    alert(data.message || "Failed to create payment order.");
                    payBtn.disabled = false;
                    payBtn.innerHTML = `<i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay`;
                    return;
                }

                // If running in test simulation mode (without live API keys in .env)
                if (data.isTestSimulated) {
                    const verifyRes = await fetch(`/listings/${listingId}/verify-payment`, {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({
                            checkIn,
                            checkOut,
                            razorpay_order_id: data.orderId,
                            razorpay_payment_id: `pay_sim_${Date.now()}`,
                            isTestSimulated: true,
                        }),
                    });
                    const verifyData = await verifyRes.json();
                    if (verifyData.success) {
                        window.location.href = verifyData.redirectUrl || "/bookings";
                    } else {
                        alert(verifyData.message || "Simulated payment verification failed.");
                        payBtn.disabled = false;
                    }
                    return;
                }

                // Step 2: Open Official Razorpay Checkout Modal
                const options = {
                    key: data.keyId,
                    amount: data.amount,
                    currency: data.currency,
                    name: "Wanderlust Stays",
                    description: `Booking for ${data.listingTitle} (${data.nights} night/s)`,
                    order_id: data.orderId,
                    handler: async function (response) {
                        payBtn.innerHTML = `<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Verifying Payment...`;
                        const verifyRes = await fetch(`/listings/${listingId}/verify-payment`, {
                            method: "POST",
                            headers: { "Content-Type": "application/json" },
                            body: JSON.stringify({
                                checkIn,
                                checkOut,
                                razorpay_order_id: response.razorpay_order_id,
                                razorpay_payment_id: response.razorpay_payment_id,
                                razorpay_signature: response.razorpay_signature,
                                isTestSimulated: false,
                            }),
                        });
                        const verifyData = await verifyRes.json();
                        if (verifyData.success) {
                            window.location.href = verifyData.redirectUrl || "/bookings";
                        } else {
                            alert(verifyData.message || "Razorpay signature verification failed.");
                            payBtn.disabled = false;
                            payBtn.innerHTML = `<i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay`;
                        }
                    },
                    modal: {
                        ondismiss: function () {
                            payBtn.disabled = false;
                            payBtn.innerHTML = `<i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay`;
                        }
                    },
                    prefill: {
                        name: currUserName,
                        email: currUserEmail,
                    },
                    theme: {
                        color: "#fe424d",
                    },
                };

                const rzp = new Razorpay(options);
                rzp.on("payment.failed", function (response) {
                    alert("Payment failed: " + (response.error ? response.error.description : "Transaction cancelled"));
                    payBtn.disabled = false;
                    payBtn.innerHTML = `<i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay`;
                });
                rzp.open();
            } catch (err) {
                console.error("Razorpay Payment error:", err);
                alert("An error occurred during Razorpay checkout. Please try again.");
                payBtn.disabled = false;
                payBtn.innerHTML = `<i class="fa-solid fa-lock me-2"></i>Reserve & Pay with Razorpay`;
            }
        });
    }

    // Leaflet Map Initialization
    const coordinates = <%- JSON.stringify(listing.geometry && listing.geometry.coordinates && (listing.geometry.coordinates[0] !== 0 || listing.geometry.coordinates[1] !== 0) ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;
    const listingLocation = <%- JSON.stringify(listing.location + ", " + listing.country) %>;
    const listingTitle = <%- JSON.stringify(listing.title) %>;

    const lat = coordinates[1];
    const lng = coordinates[0];
    
    const map = L.map('map').setView([lat, lng], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    const redIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    const marker = L.marker([lat, lng], { icon: redIcon }).addTo(map);
    marker.bindPopup(`<b>${listingTitle}</b><br><small>${listingLocation}</small><br>Exact location provided after booking!`).openPopup();
</script>
