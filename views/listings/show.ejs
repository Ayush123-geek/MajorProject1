<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-lg-8 offset-lg-2">
        <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-2">
            <h2 class="fw-bold mb-0"><%= listing.title %></h2>
            <% if(currUser) { %>
                <form method="POST" action="/listings/<%= listing._id %>/wishlist">
                    <button type="submit" class="btn btn-outline-danger rounded-pill px-3 shadow-sm">
                        <% if(currUserWishlist.includes(listing._id.toString())) { %>
                            <i class="fa-solid fa-heart me-1"></i> Saved in Wishlist
                        <% } else { %>
                            <i class="fa-regular fa-heart me-1"></i> Save to Wishlist
                        <% } %>
                    </button>
                </form>
            <% } %>
        </div>
        <p class="text-muted"><i class="fa-solid fa-location-dot me-1 text-danger"></i><%= listing.location %>, <%= listing.country %></p>
    </div>

    <div class="col-lg-8 offset-lg-2">
        <div class="card show-card listing-card">
            <div class="card-img-container" style="height: 26rem;">
                <img src="<%= listing.image.url%>" class="card-img-top show-img" alt="listing_img">
                <% if (listing.category) { %>
                    <span class="category-badge fs-6 px-3 py-1"><%= listing.category %></span>
                <% } %>
            </div>
            <div class="card-body p-4">
                <div class="d-flex align-items-center gap-3 mb-3">
                    <div class="bg-secondary bg-opacity-10 text-brand rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.25rem; background-color: rgba(254, 66, 77, 0.1); color: #fe424d;">
                        <i class="fa-solid fa-user-shield"></i>
                    </div>
                    <div>
                        <h6 class="mb-0 fw-bold">Hosted by <%= listing.owner ? listing.owner.username : 'Wanderlust Host' %></h6>
                        <small class="text-muted">Verified Host &bull; Superhost Status</small>
                    </div>
                </div>
                <hr>
                <h5 class="fw-bold">About this stay</h5>
                <p class="card-text text-secondary lh-lg"><%= listing.description %></p>

                <!-- Pricing & GST Breakdown Box -->
                <div class="p-3 my-4 rounded-3 border bg-body-tertiary">
                    <h6 class="fw-bold mb-3"><i class="fa-solid fa-receipt me-2 text-danger"></i>Price Breakdown</h6>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Base Price (1 night)</span>
                        <span class="fw-semibold">&#8377; <%= listing.price ? listing.price.toLocaleString("en-IN") : 0 %></span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">GST Tax (18%)</span>
                        <span class="fw-semibold">&#8377; <%= listing.price ? Math.round(listing.price * 0.18).toLocaleString("en-IN") : 0 %></span>
                    </div>
                    <hr class="my-2">
                    <div class="d-flex justify-content-between fs-5 fw-bold">
                        <span>Total Price (incl. taxes)</span>
                        <span class="text-danger">&#8377; <%= listing.price ? Math.round(listing.price * 1.18).toLocaleString("en-IN") : 0 %></span>
                    </div>
                </div>
            </div>
        </div>

        <% if(currUser && listing.owner && currUser._id.equals(listing.owner._id)) { %>
            <div class="d-flex gap-2 mb-4">
                <a href="/listings/<%= listing._id %>/edit" class="btn edit-btn px-4">Edit Listing</a>
                <form method="post" action="/listings/<%= listing._id %>?_method=Delete">
                    <button class="btn btn-dark px-4">Delete Listing</button>
                </form>
            </div>
        <% } %>
    </div>

    <!-- Map Section -->
    <div class="col-lg-8 offset-lg-2 mb-4">
        <hr>
        <h4 class="fw-bold mb-3"><i class="fa-solid fa-map-location-dot me-2 text-danger"></i>Where you'll be</h4>
        <div id="map"></div>
    </div>

    <!-- Reviews Section -->
    <div class="col-lg-8 offset-lg-2 mb-4">
        <hr>
        <% if(currUser) { %>
            <h4 class="fw-bold mb-3">Leave a Review</h4>
            <form action="/listings/<%= listing._id %>/reviews" method="post" novalidate class="needs-validation">
                <div class="mb-3">
                    <label for="rating" class="form-label fw-semibold">Rating</label>
                    <fieldset class="starability-slot">
                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                        <label for="first-rate1" title="Terrible">1 star</label>
                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                        <label for="first-rate2" title="Not good">2 stars</label>
                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                        <label for="first-rate3" title="Average">3 stars</label>
                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                        <label for="first-rate4" title="Very good">4 stars</label>
                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                        <label for="first-rate5" title="Amazing">5 stars</label>
                    </fieldset>
                </div>
                <div class="mb-3">
                    <label for="comment" class="form-label fw-semibold">Comment</label>
                    <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" placeholder="Share details of your experience..." required></textarea>
                    <div class="invalid-feedback">Please add some comments for review!</div>
                </div>
                <button class="btn btn-brand">Submit Review</button>
            </form>
            <hr>
        <% } %>

        <% if(listing.reviews.length > 0) { %>
            <h4 class="fw-bold mb-3">All Guest Reviews (<%= listing.reviews.length %>)</h4>
            <div class="row row-cols-1 row-cols-md-2 g-3">
                <% for(review of listing.reviews) { %>
                    <div class="col">
                        <div class="card h-100 p-3 shadow-sm border">
                            <div class="card-body p-0">
                                <div class="d-flex align-items-center gap-2 mb-2">
                                    <div class="rounded-circle bg-danger bg-opacity-10 text-danger fw-bold d-flex align-items-center justify-content-center" style="width: 36px; height: 36px;">
                                        <%= (review.author ? review.author.username : 'U')[0].toUpperCase() %>
                                    </div>
                                    <div>
                                        <h6 class="card-title mb-0 fw-bold">@<%= review.author ? review.author.username : 'User' %></h6>
                                        <p class="starability-result card-text mb-0" data-rating="<%= review.rating %>"></p>
                                    </div>
                                </div>
                                <p class="card-text text-secondary mt-2"><%= review.comment %></p>
                            </div>
                            <% if(currUser && review.author && currUser._id.equals(review.author._id)) { %>
                                <form class="mt-3 text-end" method="post" action="/listings/<%=listing._id %>/reviews/<%=review._id%>?_method=Delete">
                                    <button class="btn btn-sm btn-outline-danger">Delete Review</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } %>
    </div>
</div>

<script>
    // Pass listing geometry and details to client script
    const coordinates = <%- JSON.stringify(listing.geometry && listing.geometry.coordinates && (listing.geometry.coordinates[0] !== 0 || listing.geometry.coordinates[1] !== 0) ? listing.geometry.coordinates : [77.2090, 28.6139]) %>;
    const listingLocation = <%- JSON.stringify(listing.location + ", " + listing.country) %>;
    const listingTitle = <%- JSON.stringify(listing.title) %>;

    // Initialize Leaflet Map (Note: Leaflet takes [lat, lng])
    const lat = coordinates[1];
    const lng = coordinates[0];
    
    const map = L.map('map').setView([lat, lng], 12);

    L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors'
    }).addTo(map);

    // Custom Red Pin Marker
    const redIcon = L.icon({
        iconUrl: 'https://raw.githubusercontent.com/pointhi/leaflet-color-markers/master/img/marker-icon-red.png',
        shadowUrl: 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/0.7.7/images/marker-shadow.png',
        iconSize: [25, 41],
        iconAnchor: [12, 41],
        popupAnchor: [1, -34],
        shadowSize: [41, 41]
    });

    const marker = L.marker([lat, lng], { icon: redIcon }).addTo(map);
    marker.bindPopup(`<b>${listingTitle}</b><br><small>${listingLocation}</small><br>Exact location provided after booking!`).openPopup();
</script>
