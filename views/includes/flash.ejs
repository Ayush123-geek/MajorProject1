<div class="toast-container-custom">
  <% if(success && success.length){ %>
    <div class="custom-toast toast-success alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-check fa-lg text-success"></i>
      <div><%= success %></div>
      <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>

  <% if(error && error.length){ %>
    <div class="custom-toast toast-error alert-dismissible fade show" role="alert">
      <i class="fa-solid fa-circle-exclamation fa-lg text-danger"></i>
      <div><%= error %></div>
      <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
  <% } %>
</div>