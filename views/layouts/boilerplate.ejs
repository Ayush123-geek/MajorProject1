<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wanderlust — Explore Amazing Stays</title>
    
    <!-- Theme Initializer (Prevents FOUC) -->
    <script>
      (function() {
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-bs-theme', savedTheme);
      })();
    </script>

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous">
    <!-- FontAwesome 6 Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" crossorigin="anonymous" referrerpolicy="no-referrer" />
    
    <!-- Custom Styles -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/rating.css">

    <!-- Leaflet CSS for Maps -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="" />
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>

    <!-- Marked.js Markdown Parser -->
    <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
</head>
<body>
    <%- include("../includes/navbar.ejs") %>
    <div class="container my-4">
        <%- include("../includes/flash.ejs") %>
        <%- body %>
    </div>
    <%- include("../includes/footer.ejs") %>

    <!-- Floating AI Concierge FAB Button -->
    <button id="aiFabBtn" class="ai-fab-btn" title="AI Travel Concierge">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>AI Concierge</span>
    </button>

    <!-- Floating AI Chatbot Drawer Window -->
    <div id="aiChatDrawer" class="ai-chat-drawer shadow-lg">
        <div class="ai-chat-header">
            <div class="d-flex align-items-center gap-2">
                <i class="fa-solid fa-wand-magic-sparkles fs-5"></i>
                <div>
                    <h6 class="mb-0 fw-bold">Wanderlust AI Assistant</h6>
                    <small style="font-size: 0.75rem; opacity: 0.85;">Powered by Google Gemini</small>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2">
                <button type="button" class="btn btn-sm btn-link text-white p-0 text-decoration-none opacity-75 hover-opacity-100" id="clearAiChatBtn" title="Clear Chat">
                    <i class="fa-solid fa-rotate-right"></i>
                </button>
                <button type="button" class="btn-close btn-close-white" id="closeAiChatBtn" aria-label="Close"></button>
            </div>
        </div>

        <div class="ai-chat-body" id="aiChatBody">
            <!-- Welcome Message -->
            <div class="ai-chat-bubble bot-bubble">
                <p class="mb-1 fw-bold">Hello! I'm your AI Travel Concierge 🌴</p>
                <p class="mb-0 small text-muted">Where would you like to travel? Ask me for custom itineraries, weekend getaways, or stay recommendations!</p>
            </div>

            <!-- Quick Suggestions -->
            <div class="d-flex flex-wrap gap-1" id="aiQuickChips">
                <span class="ai-quick-chip" onclick="askAiQuick('3-day weekend trip to Goa under ₹12,000')">🏖️ 3 Days in Goa</span>
                <span class="ai-quick-chip" onclick="askAiQuick('Budget mountain stay in Manali under ₹8,000')">🏔️ Manali Mountains</span>
                <span class="ai-quick-chip" onclick="askAiQuick('Romantic 2-day getaway in Udaipur under ₹15,000')">🏰 Royal Udaipur</span>
            </div>
        </div>

        <!-- Chat Input Footer -->
        <div class="ai-chat-footer">
            <form id="aiChatForm" class="d-flex gap-2">
                <input type="text" id="aiChatInput" class="form-control rounded-pill form-control-sm" placeholder="Ask AI anything (e.g. 3 days in Jaipur...)" required autocomplete="off">
                <button type="submit" class="btn btn-brand btn-sm rounded-circle px-2.5" id="aiSendBtn" title="Send">
                    <i class="fa-solid fa-paper-plane"></i>
                </button>
            </form>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.7/dist/js/bootstrap.bundle.min.js" crossorigin="anonymous"></script>
    <script src="/js/script.js"></script>

    <!-- Global Floating AI Chatbot Script -->
    <script>
        const aiFabBtn = document.getElementById("aiFabBtn");
        const aiChatDrawer = document.getElementById("aiChatDrawer");
        const closeAiChatBtn = document.getElementById("closeAiChatBtn");
        const clearAiChatBtn = document.getElementById("clearAiChatBtn");
        const aiChatForm = document.getElementById("aiChatForm");
        const aiChatInput = document.getElementById("aiChatInput");
        const aiChatBody = document.getElementById("aiChatBody");
        const aiSendBtn = document.getElementById("aiSendBtn");

        const initialBotWelcome = `
            <div class="ai-chat-bubble bot-bubble">
                <p class="mb-1 fw-bold">Hello! I'm your AI Travel Concierge 🌴</p>
                <p class="mb-0 small text-muted">Where would you like to travel? Ask me for custom itineraries, weekend getaways, or stay recommendations!</p>
            </div>
            <div class="d-flex flex-wrap gap-1" id="aiQuickChips">
                <span class="ai-quick-chip" onclick="askAiQuick('3-day weekend trip to Goa under ₹12,000')">🏖️ 3 Days in Goa</span>
                <span class="ai-quick-chip" onclick="askAiQuick('Budget mountain stay in Manali under ₹8,000')">🏔️ Manali Mountains</span>
                <span class="ai-quick-chip" onclick="askAiQuick('Romantic 2-day getaway in Udaipur under ₹15,000')">🏰 Royal Udaipur</span>
            </div>
        `;

        if (aiFabBtn && aiChatDrawer) {
            aiFabBtn.addEventListener("click", () => {
                aiChatDrawer.classList.toggle("show");
                if (aiChatDrawer.classList.contains("show")) {
                    aiChatInput.focus();
                }
            });

            closeAiChatBtn.addEventListener("click", () => {
                aiChatDrawer.classList.remove("show");
            });

            // Dismiss with Escape Key
            document.addEventListener("keydown", (e) => {
                if (e.key === "Escape" && aiChatDrawer.classList.contains("show")) {
                    aiChatDrawer.classList.remove("show");
                }
            });
        }

        if (clearAiChatBtn) {
            clearAiChatBtn.addEventListener("click", () => {
                aiChatBody.innerHTML = initialBotWelcome;
            });
        }

        function askAiQuick(promptText) {
            aiChatInput.value = promptText;
            submitAiChat();
        }

        if (aiChatForm) {
            aiChatForm.addEventListener("submit", (e) => {
                e.preventDefault();
                submitAiChat();
            });
        }

        async function submitAiChat() {
            const query = aiChatInput.value.trim();
            if (!query) return;

            // Append User Bubble
            const userBubble = document.createElement("div");
            userBubble.className = "ai-chat-bubble user-bubble";
            userBubble.textContent = query;
            aiChatBody.appendChild(userBubble);
            aiChatInput.value = "";
            aiChatBody.scrollTop = aiChatBody.scrollHeight;

            // Append Loading Bot Bubble
            const botBubble = document.createElement("div");
            botBubble.className = "ai-chat-bubble bot-bubble";
            botBubble.innerHTML = `<div class="d-flex align-items-center gap-2"><span class="spinner-border spinner-border-sm text-danger" role="status"></span><span class="small text-muted">AI is planning your trip...</span></div>`;
            aiChatBody.appendChild(botBubble);
            aiChatBody.scrollTop = aiChatBody.scrollHeight;

            aiSendBtn.disabled = true;

            try {
                const res = await fetch("/ai/chat-stream", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ query }),
                });

                const data = await res.json();
                if (data.success) {
                    botBubble.innerHTML = marked.parse(data.reply);
                } else {
                    botBubble.innerHTML = `<span class="text-danger small">${data.message || 'Sorry, something went wrong.'}</span>`;
                }
            } catch (err) {
                botBubble.innerHTML = `<span class="text-danger small">Network error. Please try again.</span>`;
            }

            aiSendBtn.disabled = false;
            aiChatBody.scrollTop = aiChatBody.scrollHeight;
        }
    </script>
</body>
</html>